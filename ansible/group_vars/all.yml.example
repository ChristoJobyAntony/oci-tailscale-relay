# Copy this file to ansible/group_vars/all.yml and store the real key safely.
# Consider using Ansible Vault for this file.

tailscale_auth_key: "tskey-auth-REPLACE_ME"
tailscale_enable_ssh: true
# Let tailscaled upgrade itself from the Tailscale apt repo (unattended-upgrades does not cover it).
tailscale_auto_update: true

relay_udp_port: 40000

# Per-node settings (tailscale_mode, tailscale_tags) live in group_vars/<group>.yml;
# the Tailscale hostname is the inventory name.
