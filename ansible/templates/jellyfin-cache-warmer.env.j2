# {{ ansible_managed }}
# Environment for jellyfin-cache-warmer.service. Contains the Jellyfin API key.
JELLYFIN_API_KEY={{ jellyfin_api_key }}
PROXY_URL=http://{{ jf_listen_ip }}:{{ jf_listen_port }}
WARM_USERS={{ jellyfin_warm_users | default(['admin']) | join(',') }}
WARM_BUDGET={{ jellyfin_warm_budget | default('80g') }}
WARM_RATE_MBIT={{ jellyfin_warm_rate_mbit | default(30) }}
WARM_RECENT_DAYS={{ jellyfin_warm_recent_days | default(14) }}
WARM_WINDOW={{ jellyfin_warm_window | default('22:00-08:00') }}
WARM_TZ={{ jellyfin_warm_tz | default('Asia/Dubai') }}
WARM_COLLECTION={{ jellyfin_warm_collection | default('Pre-cache') }}
RESUME_LIMIT={{ jellyfin_warm_resume_limit | default(8) }}
NEXTUP_LIMIT={{ jellyfin_warm_nextup_limit | default(10) }}
LATEST_LIMIT={{ jellyfin_warm_latest_limit | default(30) }}
WARM_SLICE={{ jf_slice_size }}
CACHE_DIR={{ jf_cache_dir }}/media
MAX_RUN_SECONDS={{ jellyfin_warm_max_run_seconds | default(1500) }}
