# {{ ansible_managed }}
#
# Jellyfin caching reverse proxy. Tailnet clients talk to this node instead of
# the home Jellyfin server. Direct-play media is fetched from the upstream in
# {{ jf_slice_size }} slices and cached on local disk, so replays and seeks are
# served from here rather than across the high-latency path to the home server.
# Transcoded (HLS) sessions, the API and the websocket pass through uncached.

upstream jellyfin_upstream {
    server {{ jf_upstream_host }}:{{ jf_upstream_port }};
    keepalive 16;
}

# Original-file media slices: large and long-lived.
proxy_cache_path {{ jf_cache_dir }}/media levels=1:2 keys_zone=jf_media:100m
                 max_size={{ jf_cache_max_size }} inactive={{ jf_cache_inactive }} use_temp_path=off;

# Artwork: small and cheap to refetch.
proxy_cache_path {{ jf_cache_dir }}/images levels=1:2 keys_zone=jf_images:20m
                 max_size=2g inactive=30d use_temp_path=off;

log_format jf_cache '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                    'cache=$upstream_cache_status up=$upstream_status rt=$request_time '
                    'upstream=$upstream_response_time ua="$http_user_agent"';

# Only Static=true streams are byte-for-byte copies of the file and safe to
# cache. Anything else may be remuxed or transcoded per session.
map "$arg_Static$arg_static" $jf_skip_cache {
    default  1;
    ~*true   0;
}

server {
    listen {{ jf_listen_ip }}:{{ jf_listen_port }};
    server_name _;

    client_max_body_size 20M;
    access_log /var/log/nginx/jellyfin-cache.access.log jf_cache;
    error_log  /var/log/nginx/jellyfin-cache.error.log;

    # Direct-play media streams, e.g. /Videos/{id}/stream.mkv?Static=true&mediaSourceId=...
    # The cache key is built from the item id rather than the raw path, so
    # /Videos/{id}/stream.mkv and /videos/{id}/stream (different clients) share
    # one cache entry, and a pre-warmed file is a hit for every client.
    location ~* ^/(videos|audio)/(?<jf_item>[^/]+)/stream(\.[a-z0-9]+)?$ {
        include snippets/jellyfin-proxy-headers.conf;
        proxy_pass http://jellyfin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        slice {{ jf_slice_size }};
        proxy_set_header Range $slice_range;

        # Finish and store an in-flight slice even if the player seeks away.
        proxy_ignore_client_abort on;

        # The key deliberately excludes the client's Tag (ETag) parameter: the
        # web client sends it, Kodi does not, and including it would split the
        # cache per client. Freshness comes from revalidation instead: once a
        # slice is older than {{ jf_cache_valid }}, the next request for it
        # asks the upstream "changed since Last-Modified?" (Jellyfin answers
        # 304 in one round trip) before serving it. Do NOT enable
        # proxy_cache_background_update here: with the slice module the
        # background clone loses its Range and pulls the whole file.
        proxy_cache jf_media;
        proxy_cache_key "jf|$jf_item|$arg_mediaSourceId$arg_MediaSourceId|$slice_range";
        proxy_cache_valid 200 206 {{ jf_cache_valid }};
        proxy_cache_revalidate on;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 60s;
        proxy_cache_lock_age 60s;
        proxy_cache_use_stale error timeout updating;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_no_cache $jf_skip_cache;
        proxy_cache_bypass $jf_skip_cache;

        proxy_buffering on;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Artwork: posters, backdrops, avatars.
    location ~* ^/(items|users|artists|genres|musicgenres|studios|persons|years)/[^/]+/images/ {
        include snippets/jellyfin-proxy-headers.conf;
        proxy_pass http://jellyfin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache jf_images;
        proxy_cache_key "$uri$is_args$args";
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;

        proxy_buffering on;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Websocket used for session state and remote control.
    location /socket {
        include snippets/jellyfin-proxy-headers.conf;
        proxy_pass http://jellyfin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Everything else: web UI, API, HLS transcodes. Straight through, no cache.
    location / {
        include snippets/jellyfin-proxy-headers.conf;
        proxy_pass http://jellyfin_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
